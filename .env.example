# Copy to .env (never commit .env). All values are optional.
PORT=3001
HOST=127.0.0.1

# Optional AI provider. Leave empty to use the deterministic fallback summary.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Comma-separated hostnames exempt from the private-network block (local dev only).
# Example: ALLOW_HOSTS=localhost,127.0.0.1   (leave empty in any shared deployment)
ALLOW_HOSTS=

MAX_PAGES_CAP=50
MAX_CONCURRENT_SCANS=2
